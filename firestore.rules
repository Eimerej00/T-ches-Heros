rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows full real-time synchronization of the family chore workspace
    // for authorized family devices (whitelisted Google parents & PIN-unlocked devices)
    match /families/{familyId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

